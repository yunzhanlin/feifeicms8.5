APP_DEBUG = false
APP_TRACE = false
APP_KEY = change-this-to-a-long-random-string
APP_URL = http://localhost:8080

DB_TYPE = mysql
DB_HOST = mysql
DB_NAME = feifeicms
DB_USER = feifeicms
DB_PASS = change-database-password
MYSQL_ROOT_PASSWORD = change-root-database-password
DB_PORT = 3306
DB_CHARSET = utf8mb4
DB_PREFIX = ff_

CACHE_DRIVER = redis
REDIS_HOST = redis
REDIS_PORT = 6379
REDIS_PASSWORD =
REDIS_DB = 0
REDIS_PREFIX = ff8:

SEARCH_DRIVER = meilisearch
MEILISEARCH_HOST = http://meilisearch:7700
MEILISEARCH_KEY = change-meilisearch-master-key
MEILISEARCH_INDEX = feifeicms_media
SEARCH_FALLBACK = mysql

SESSION_DRIVER = cache
SESSION_STORE = redis
SESSION_NAME = FFSESSID

DEFAULT_LANG = zh-cn
INSTALL_ENABLED = false
