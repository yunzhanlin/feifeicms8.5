{include file="admin/layout/header" /}
<div class="section-heading"><div><p class="eyebrow">Operations</p><h1>{$label|htmlspecialchars|raw}管理</h1></div><a class="button" href="/admin/operations/{$type}/create">新增{$label|htmlspecialchars|raw}</a></div>
<form method="post" action="/admin/operations/{$type}/batch" data-confirm="确定执行批量操作？"><input type="hidden" name="_token" value="{$csrf|htmlspecialchars|raw}"><div class="table-wrap"><table class="data-table"><thead><tr><th class="w40"><input type="checkbox" data-check-all></th><th>ID</th><th>名称</th><th>{if $type == 'navigation'}上级/目标{else /}标识/目标{/if}</th><th>排序</th><th>状态</th><th>操作</th></tr></thead><tbody>{volist name="items" id="item"}<tr><td><input type="checkbox" name="ids[]" value="{$item.id}"></td><td>{$item.id}</td><td>{if $type == 'navigation'}{$item.title|htmlspecialchars|raw}{else /}{$item.name|htmlspecialchars|raw}{/if}</td><td>{if $type == 'navigation'}<small>{$item.parent_title|htmlspecialchars|raw}</small><br>{/if}<code>{if $type == 'players'}{$item.player_key|htmlspecialchars|raw}{elseif $type == 'ads'}{$item.slot_key|htmlspecialchars|raw}{elseif $type == 'slides'}{$item.target_url|htmlspecialchars|raw}{else /}{$item.url|htmlspecialchars|raw}{/if}</code></td><td>{if $type != 'ads'}<input class="w70" type="number" name="sort[{$item.id}]" value="{$item.sort_order|default=0}">{else /}-{/if}</td><td><span class="status status-{$item.status|htmlspecialchars|raw}">{$item.status|htmlspecialchars|raw}</span></td><td><a class="text-link" href="/admin/operations/{$type}/{$item.id}/edit">编辑</a></td></tr>{/volist}{empty name="items"}<tr><td colspan="7">暂无数据</td></tr>{/empty}</tbody></table></div><div class="legacy-toolbar"><button name="action" value="save_sort" type="submit">保存排序</button><button name="action" value="enable" type="submit">启用</button><button name="action" value="disable" type="submit">禁用</button><button class="danger" name="action" value="delete" type="submit">删除</button></div></form>
{include file="admin/layout/footer" /}
