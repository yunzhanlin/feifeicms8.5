{include file="admin/layout/header" /}
<div class="section-heading"><div><h1>数据库备份</h1><p class="muted">MySQL {$version|htmlspecialchars|raw}，仅处理 FeiFeiCMS 的 ffx_* 业务表</p></div></div>
{if condition="$message neq ''"}<div class="notice">{$message|htmlspecialchars|raw}</div>{/if}
<form method="post" action="/admin/database/backup"><input type="hidden" name="_token" value="{$csrf|htmlspecialchars|raw}"><div class="table-wrap"><table class="data-table"><thead><tr><th width="90">选择</th><th width="260">表名</th><th width="100">记录数</th><th width="120">数据大小</th><th width="100">引擎</th><th>排序规则</th></tr></thead><tbody>{volist name="tables" id="table"}<tr><td><input type="checkbox" name="ids[]" value="{$table.name|htmlspecialchars|raw}" checked></td><td>{$table.name|htmlspecialchars|raw}</td><td class="text-center">{$table.row_count}</td><td class="text-center">{$table.bytes} bytes</td><td class="text-center">{$table.engine|htmlspecialchars|raw}</td><td class="text-center">{$table.collation|htmlspecialchars|raw}</td></tr>{/volist}</tbody></table><div class="table-footer"><button type="button" data-check-all>全选/反选</button><button type="submit">开始备份</button><button type="submit" formaction="/admin/database/check">检查选中表</button><button type="submit" formaction="/admin/database/repair" data-confirm="确定修复维护选中数据表？InnoDB 表会执行安全分析。">修复维护</button><button id="optimize" type="submit" formaction="/admin/database/optimize" data-confirm="确定优化选中数据表？">数据库优化</button></div></div></form>
<section class="section-block" id="backups"><div class="section-heading"><h2>数据库恢复文件</h2><small>仅可恢复本系统生成的 ffx_* 备份，还原前请确认当前数据可以被覆盖</small></div><div class="table-wrap"><table class="data-table"><thead><tr><th>文件名</th><th width="120">文件大小</th><th width="170">备份时间</th><th width="210">操作</th></tr></thead><tbody>{volist name="backups" id="backup"}<tr><td>{$backup.name|htmlspecialchars|raw}</td><td class="text-center">{$backup.size} bytes</td><td class="text-center">{$backup.created_at|htmlspecialchars|raw}</td><td class="text-center"><a href="/admin/database/backups/{$backup.name|htmlspecialchars|raw}">下载</a> <form class="inline-form" method="post" action="/admin/database/backups/{$backup.name|htmlspecialchars|raw}/restore"><input type="hidden" name="_token" value="{$csrf|htmlspecialchars|raw}"><input type="hidden" name="confirm" value="RESTORE"><button type="submit" data-confirm="恢复会覆盖备份内的数据表，确定继续？">还原</button></form> <form class="inline-form" method="post" action="/admin/database/backups/{$backup.name|htmlspecialchars|raw}/delete"><input type="hidden" name="_token" value="{$csrf|htmlspecialchars|raw}"><button type="submit" data-confirm="确定删除这个备份文件？">删除</button></form></td></tr>{/volist}</tbody></table></div></section>
<section class="section-block" id="diagnostics"><div class="section-heading"><h2>数据诊断</h2></div><div class="notice">已启用表名白名单、CSRF 校验、私有备份目录和操作审计；不在 Web 后台提供任意 SQL 执行器。</div></section>
{include file="admin/layout/footer" /}
