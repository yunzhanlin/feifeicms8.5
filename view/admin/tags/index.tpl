{include file="admin/layout/header" /}
<div class="section-heading"><div><h1>标签管理</h1></div></div>
<form class="legacy-filter" method="get" action="/admin/tags"><div class="legacy-filter-title"><span>标签筛选</span></div><div class="legacy-filter-row"><label>标签搜索：</label><div><input name="wd" value="{$keyword|htmlspecialchars|raw}" placeholder="标签名称"><select name="scope"><option value="">全部类型</option><option value="media" {if $scope == 'media'}selected{/if}>视频</option><option value="article" {if $scope == 'article'}selected{/if}>文章</option></select><button type="submit">搜索</button></div></div></form>
<div class="table-wrap"><table class="data-table"><thead><tr><th>ID</th><th>标签名称</th><th width="100">收录数量</th><th width="100">所属类型</th><th width="180">相关操作</th></tr></thead><tbody>{volist name="items" id="item"}<tr><td>{$item.id}</td><td><form class="inline-form compact" method="post" action="/admin/tags/{$item.id}/update"><input type="hidden" name="_token" value="{$csrf|htmlspecialchars|raw}"><input name="name" value="{$item.name|htmlspecialchars|raw}" maxlength="100" required><button type="submit">改名</button></form></td><td class="text-center">{$item.usage_count}条</td><td class="text-center"><a href="/admin/tags?scope={$item.scope|htmlspecialchars|raw}">{if $item.scope == 'media'}视频{else /}文章{/if}</a></td><td class="actions"><form method="post" action="/admin/tags/{$item.id}/delete" data-confirm="确定删除该标签及其关联？"><input type="hidden" name="_token" value="{$csrf|htmlspecialchars|raw}"><button class="link-button" type="submit">删除</button></form></td></tr>{/volist}{empty name="items"}<tr><td colspan="5">暂无标签</td></tr>{/empty}</tbody></table></div>
<form class="editor-form" method="post" action="/admin/tags"><input type="hidden" name="_token" value="{$csrf|htmlspecialchars|raw}"><section class="editor-section"><h2>添加标签</h2><div class="form-grid"><label>标签名称<input name="name" maxlength="100" required></label><label>所属类型<select name="scope"><option value="media">视频</option><option value="article">文章</option></select></label></div><div class="form-actions"><button type="submit">添加</button></div></section></form>
<form class="editor-form" method="post" action="/admin/tags/merge" data-confirm="合并后来源标签会删除，确定继续？"><input type="hidden" name="_token" value="{$csrf|htmlspecialchars|raw}"><section class="editor-section"><h2>合并标签</h2><div class="form-grid"><label>来源标签 ID<input name="source_id" type="number" min="1" required></label><label>目标标签 ID<input name="target_id" type="number" min="1" required></label></div><p class="form-hint">来源标签的全部视频或文章关联会移动到目标标签，重复关联会自动去重。</p><div class="form-actions"><button type="submit">执行合并</button></div></section></form>
{include file="admin/layout/footer" /}
