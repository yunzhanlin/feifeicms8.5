{include file="admin/layout/header" /}
<div class="title"><div class="tabs"><a class="active" href="#admin-form">{if $isNew}添加管理员{else /}编辑管理员{/if}</a></div><div class="actions"><a href="/admin/administrators">返回列表</a></div></div>
<form class="editor-form" id="admin-form" method="post" action="{if $isNew}/admin/administrators{else /}/admin/administrators/{$item.id}{/if}"><input type="hidden" name="_token" value="{$csrf|htmlspecialchars|raw}"><section class="editor-section"><label>管理员名<input name="username" value="{$item.username|htmlspecialchars|raw}" maxlength="80" required></label><label>邮箱<input name="email" type="email" value="{$item.email|default=''|htmlspecialchars|raw}"></label><label>{if $isNew}登录密码{else /}新密码{/if}<span><input name="password" type="password" minlength="12" {if $isNew}required{/if}><small class="form-hint">{if !$isNew}留空不修改；{/if}至少 12 位</small></span></label><label>权限角色<select name="role_id" required>{volist name="roles" id="role"}<option value="{$role.id}" {if $role.id == $roleId}selected{/if}>{$role.name|htmlspecialchars|raw}</option>{/volist}</select></label><label>账号状态<select name="status" {if $item.id == $currentId}disabled{/if}><option value="active" {if $item.status == 'active'}selected{/if}>启用</option><option value="disabled" {if $item.status == 'disabled'}selected{/if}>禁用</option></select></label><div class="form-actions"><button type="submit">提交</button><button type="reset">重置</button></div></section></form>
{include file="admin/layout/footer" /}
