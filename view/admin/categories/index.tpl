{include file="admin/layout/header" /}
<div class="section-heading"><div><h1>分类管理</h1></div><a class="button" href="/admin/categories/create">添加分类</a></div>
<form method="post" action="/admin/categories/batch"><input type="hidden" name="_token" value="{$csrf|htmlspecialchars|raw}"><input type="hidden" name="action" value="update"><div class="table-wrap"><table class="data-table legacy-category-table"><thead><tr><th class="category-name-heading">ID.分类名称</th><th width="90">创建</th><th width="100">状态</th><th width="90">模型</th><th width="80">排序</th><th width="140">中文名</th><th width="170">英文名</th><th width="100">管理操作</th></tr></thead><tbody>{volist name="items" id="item"}<tr><td class="category-name-cell"><input class="category-check" type="checkbox" name="ids[]" value="{$item.id}" checked>{if $item.parent_id}<span class="category-tree-indent">├</span>{/if}{$item.id}、<a href="/list/{$item.id}" target="_blank">{$item.name|htmlspecialchars|raw}</a></td><td class="text-center"><a href="/admin/categories/create?parent_id={$item.id}">创建子类</a></td><td class="text-center"><select name="statuses[{$item.id}]"><option value="published" {if $item.status == 'published'}selected{/if}>显示</option><option value="draft" {if $item.status == 'draft'}selected{/if}>隐藏</option></select></td><td class="text-center">{switch name="item.content_type"}{case value="media"}视频{/case}{case value="article"}文章{/case}{case value="topic"}专题{/case}{case value="person"}人物{/case}{case value="comment"}评论{/case}{default /}单页{/switch}</td><td><input class="inline-input" name="sort_orders[{$item.id}]" value="{$item.sort_order}" size="5"></td><td><input class="inline-input" name="names[{$item.id}]" value="{$item.name|htmlspecialchars|raw}" size="12"></td><td><input class="inline-input" value="{$item.slug|htmlspecialchars|raw}" size="16" readonly></td><td class="actions"><a href="/admin/categories/{$item.id}/edit">编辑</a></td></tr>{/volist}</tbody></table><div class="table-footer"><button type="button" data-check-all>全选/反选</button><button type="button" data-batch-action="update">批量修改</button><button type="button" data-batch-action="delete" data-confirm="删除后无法还原，已有子类或内容的分类会自动跳过，确定继续？">批量删除</button></div></div></form>
{include file="admin/layout/footer" /}
