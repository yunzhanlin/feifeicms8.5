{include file="admin/layout/header" /}
<div class="title"><div class="tabs"><a class="active">{$user.username|htmlspecialchars|raw} 的用户日志</a></div><div class="actions"><a href="/admin/users/{$user.id}/edit">编辑用户</a><a href="/admin/users">返回列表</a></div></div>
<div class="legacy-summary-grid"><span>用户ID：{$user.id}</span><span>积分：{$user.points}</span><span>用户组：{$user.group_key|htmlspecialchars|raw}</span><span>状态：{$user.status|htmlspecialchars|raw}</span><span>最后登录：{$user.last_login_at|default='-'|htmlspecialchars|raw}</span></div>
<section class="section-block"><div class="title"><div class="tabs"><a class="active">观看记录</a></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>影片</th><th>进度</th><th>观看时间</th></tr></thead><tbody>{volist name="history" id="row"}<tr><td>#{$row.media_id} {$row.title|default='影片已删除'|htmlspecialchars|raw}</td><td>{$row.progress_seconds} 秒</td><td>{$row.watched_at|htmlspecialchars|raw}</td></tr>{/volist}{empty name="history"}<tr><td colspan="3">暂无记录</td></tr>{/empty}</tbody></table></div></section>
<section class="section-block"><div class="title"><div class="tabs"><a class="active">收藏记录</a></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>影片</th><th>收藏时间</th></tr></thead><tbody>{volist name="favorites" id="row"}<tr><td>#{$row.media_id} {$row.title|default='影片已删除'|htmlspecialchars|raw}</td><td>{$row.created_at|htmlspecialchars|raw}</td></tr>{/volist}{empty name="favorites"}<tr><td colspan="2">暂无记录</td></tr>{/empty}</tbody></table></div></section>
<section class="section-block"><div class="title"><div class="tabs"><a class="active">评论记录</a></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>对象</th><th>内容</th><th>状态</th><th>时间</th></tr></thead><tbody>{volist name="comments" id="row"}<tr><td>{$row.target_type|htmlspecialchars|raw} #{$row.target_id}</td><td class="text-left">{$row.content|htmlspecialchars|raw}</td><td>{$row.status|htmlspecialchars|raw}</td><td>{$row.created_at|htmlspecialchars|raw}</td></tr>{/volist}{empty name="comments"}<tr><td colspan="4">暂无记录</td></tr>{/empty}</tbody></table></div></section>
<section class="section-block"><div class="title"><div class="tabs"><a class="active">订单记录</a></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>订单号</th><th>商品</th><th>金额</th><th>状态</th><th>时间</th></tr></thead><tbody>{volist name="orders" id="row"}<tr><td>{$row.order_no|htmlspecialchars|raw}</td><td>{$row.product_type|htmlspecialchars|raw}</td><td>{$row.amount} {$row.currency|htmlspecialchars|raw}</td><td>{$row.status|htmlspecialchars|raw}</td><td>{$row.created_at|htmlspecialchars|raw}</td></tr>{/volist}{empty name="orders"}<tr><td colspan="5">暂无记录</td></tr>{/empty}</tbody></table></div></section>
{include file="admin/layout/footer" /}
