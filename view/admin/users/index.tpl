{include file="admin/layout/header" /}
<div class="title"><div class="tabs"><a class="active" href="/admin/users">用户管理</a></div><div class="actions"><a href="/admin/billing">订单与卡密</a><a href="/admin/users/create">新增用户</a></div></div>
<form class="legacy-filter" method="get" action="/admin/users"><label>用户搜索：</label><input name="wd" value="{$keyword|htmlspecialchars|raw}" placeholder="用户名或邮箱"><select name="status"><option value="">全部状态</option><option value="active" {if $status == 'active'}selected{/if}>正常</option><option value="disabled" {if $status == 'disabled'}selected{/if}>禁用</option><option value="banned" {if $status == 'banned'}selected{/if}>封禁</option></select><select name="group"><option value="">全部用户组</option>{volist name="groups" id="groupName"}<option value="{$groupName|htmlspecialchars|raw}" {if $group == $groupName}selected{/if}>{$groupName|htmlspecialchars|raw}</option>{/volist}</select><button type="submit">搜索</button><a href="/admin/users">重置</a></form>
<form method="post" action="/admin/users/batch" data-confirm="确定执行批量用户操作？"><input type="hidden" name="_token" value="{$csrf|htmlspecialchars|raw}"><div class="table-wrap"><table class="data-table"><thead><tr><th class="w40"><input type="checkbox" data-check-all></th><th>ID</th><th>用户名</th><th>邮箱</th><th>用户组</th><th>积分</th><th>状态</th><th>最后登录</th><th>操作</th></tr></thead><tbody>{volist name="items" id="item"}<tr><td><input type="checkbox" name="ids[]" value="{$item.id}"></td><td>{$item.id}</td><td>{$item.username|htmlspecialchars|raw}</td><td>{$item.email|default='-'|htmlspecialchars|raw}</td><td>{$item.group_key|htmlspecialchars|raw}</td><td>{$item.points}</td><td>{$item.status|htmlspecialchars|raw}</td><td>{$item.last_login_at|default='-'|htmlspecialchars|raw}<br><small>{$item.last_login_ip|default=''|htmlspecialchars|raw}</small></td><td><a href="/admin/users/{$item.id}/edit">编辑</a> · <a href="/admin/users/{$item.id}/logs">用户日志</a></td></tr>{/volist}{empty name="items"}<tr><td colspan="9">暂无用户</td></tr>{/empty}</tbody></table></div><div class="legacy-toolbar"><span>批量操作：</span><button name="action" value="enable" type="submit">启用</button><button name="action" value="disable" type="submit">禁用</button><button name="action" value="ban" type="submit">封禁</button><label>积分增减 <input class="w100" type="number" name="points_delta" value="0"></label><button name="action" value="add_points" type="submit">调整积分</button><button class="danger" name="action" value="archive" type="submit">归档</button></div></form><div class="pagination">{$items|raw}</div>
{include file="admin/layout/footer" /}
