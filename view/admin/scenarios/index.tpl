{include file="admin/layout/header" /}
<div class="title"><div class="left">分集剧情管理</div><div class="right"><a href="/admin/scenarios/create">添加分集剧情</a></div></div>
<form method="get" action="/admin/scenarios" class="legacy-filter scenario-filter">
    <div class="legacy-filter-title"><span>剧情搜索</span><a href="/admin/scenarios/create">添加剧情</a></div>
    <div class="legacy-filter-row"><label for="scenario-wd">搜索：</label><div><input id="scenario-wd" name="wd" value="{$keyword|htmlspecialchars|raw}" placeholder="影片名或分集标题"><label class="inline-label" for="scenario-media">影片ID：</label><input id="scenario-media" class="short-input" name="media_id" type="number" min="0" value="{if $mediaId > 0}{$mediaId}{/if}"><select name="status"><option value="">全部状态</option><option value="draft" {if $status == 'draft'}selected{/if}>未审核</option><option value="published" {if $status == 'published'}selected{/if}>已审核</option></select><button type="submit">搜索</button><a href="/admin/scenarios">重置条件</a></div></div>
</form>
<div class="table-wrap scenario-media-list-wrap"><table class="data-table scenario-media-list"><thead><tr><th width="80">视频ID</th><th>视频名称</th><th width="110">剧情集数</th><th width="130">集数范围</th><th width="150">审核情况</th><th width="155">最后更新</th><th width="190">操作</th></tr></thead><tbody>{volist name="items" id="item"}<tr><td>{$item.media_id}</td><td class="scenario-media-name"><a href="/admin/vod/{$item.media_id}/edit">{$item.media_title|htmlspecialchars|raw}</a>{if $item.episode_total}<span>· 视频设定共{$item.episode_total}集</span>{/if}</td><td class="text-center"><strong>{$item.scenario_count}</strong> 集{if $item.missing_count > 0}<em>缺{$item.missing_count}集</em>{/if}</td><td class="text-center">第{$item.first_episode}集 — 第{$item.last_episode}集</td><td class="text-center"><span class="status status-published">已审{$item.published_count}</span> / <span class="status status-draft">待审{$item.draft_count}</span></td><td class="text-center">{$item.updated_at|htmlspecialchars|raw}</td><td class="actions"><a href="/admin/scenarios/media/{$item.media_id}">管理全部剧情</a><a href="/admin/vod/{$item.media_id}/edit">编辑视频</a></td></tr>{/volist}</tbody></table></div>
<div class="pagination">{$items|raw}</div>
{include file="admin/layout/footer" /}
